{"baseUrl":"https://s.w.org/images/core/emoji/17.0.2/72x72/","ext":".png","svgUrl":"https://s.w.org/images/core/emoji/17.0.2/svg/","svgExt":".svg","source":{"wpemoji":"/wp-includes/js/wp-emoji.js?ver=7.0","twemoji":"/wp-includes/js/twemoji.js?ver=7.0"}}
